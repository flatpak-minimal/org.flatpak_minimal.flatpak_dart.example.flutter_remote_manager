# Single source of truth for pinned versions/refs. Sourced by local scripts
# and by CI (`cat versions.env >> "$GITHUB_ENV"` — plain KEY=value lines are
# directly GITHUB_ENV-compatible). Bump deliberately via a one-line PR when a
# dependency needs to move forward — never let CI silently track a moving
# branch.

FLATPAK_RUNTIME_VERSION=25.08

# Matches packages/flatpak/example/pubspec.yaml's `environment: sdk: ^3.8.1`
# and this dev machine's validated `flutter --version` output. Do NOT reuse
# tcna-packages's own CI Flutter pin (3.32.5) — it's for that repo's older,
# unrelated pub.dev plugin packages.
FLUTTER_VERSION=3.44.2
FLUTTER_CHANNEL=stable

# Custom-patched engine (7 patches, flutter_version 3.38.3 — see
# workspace-automation/configs/flutter-engine.json) — NOT the stock engine
# `flutter precache` would fetch. Built once per arch, fetched by CI rather
# than rebuilt every push. Fill in after publishing (see CI.md).
FLUTTER_ENGINE_VERSION=77e2e94772b6eb43759e34ed1ad7da4674e19cab
FLUTTER_ENGINE_ARTIFACT_URL_AARCH64=
FLUTTER_ENGINE_ARTIFACT_URL_X86_64=

# Fork this packaging repo builds against. Pinned to a commit SHA, not a
# branch — this is a fork with no tag/release convention of its own, so a
# branch pin would let unrelated upstream changes silently flow into builds.
TCNA_PACKAGES_REPO=git@github.com:AhmedAdelWafdy7/tcna-packages.git
TCNA_PACKAGES_REF=b3eebbe2c2450f5a925118157f47360662e5fea6

IVI_HOMESCREEN_REPO=https://github.com/toyota-connected/ivi-homescreen
IVI_HOMESCREEN_REF=e48ec1c001c6170bd45a5530bf1c32341a55bf76

IVI_HOMESCREEN_PLUGINS_REPO=https://github.com/toyota-connected/ivi-homescreen-plugins
IVI_HOMESCREEN_PLUGINS_REF=v2.0

LLVM_CLANG_VERSION=18
LLVM_TOOLCHAIN_VERSION=18.1.8
# sha256 of clang+llvm-18.1.8-aarch64-linux-gnu.tar.xz — verified before use
# in the aarch64 build action (see CI.md / section 6 of the plan).
LLVM_TOOLCHAIN_AARCH64_SHA256=dcaa1bebbfbb86953fdfbdc7f938800229f75ad26c5c9375ef242edad737d999
